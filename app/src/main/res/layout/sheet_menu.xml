<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/sheet_bg"
    android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="36dp" android:paddingBottom="22dp">

    <ImageView android:id="@+id/menuClose"
        android:layout_width="40dp" android:layout_height="40dp"
        android:layout_gravity="end" android:padding="8dp"
        android:src="@drawable/ic_close" android:clickable="true" android:focusable="true"
        android:contentDescription="Close" />

    <LinearLayout android:id="@+id/aspectRow"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:layout_marginTop="12dp" android:background="@drawable/seg_bg"
        android:orientation="horizontal" />

    <LinearLayout android:id="@+id/timerRow"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:layout_marginTop="14dp" android:background="@drawable/seg_bg"
        android:orientation="horizontal" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:orientation="horizontal">

        <LinearLayout android:id="@+id/tileGrid" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal"
            android:clickable="true" android:focusable="true">
            <FrameLayout android:layout_width="72dp" android:layout_height="52dp"
                android:background="@drawable/tile_bg">
                <ImageView android:id="@+id/tileGridIcon" android:layout_width="26dp"
                    android:layout_height="26dp" android:layout_gravity="center"
                    android:src="@drawable/ic_grid" />
            </FrameLayout>
            <TextView android:id="@+id/tileGridLbl" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:textColor="#FFFFFF" android:textSize="12sp" android:text="Grid" />
        </LinearLayout>

        <LinearLayout android:id="@+id/tileBurst" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal"
            android:clickable="true" android:focusable="true">
            <FrameLayout android:layout_width="72dp" android:layout_height="52dp"
                android:background="@drawable/tile_bg">
                <ImageView android:id="@+id/tileBurstIcon" android:layout_width="26dp"
                    android:layout_height="26dp" android:layout_gravity="center"
                    android:src="@drawable/ic_burst" />
            </FrameLayout>
            <TextView android:id="@+id/tileBurstLbl" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:textColor="#FFFFFF" android:textSize="12sp" android:text="Burst: 1x" />
        </LinearLayout>

        <LinearLayout android:id="@+id/tileSettings" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal"
            android:clickable="true" android:focusable="true">
            <FrameLayout android:layout_width="72dp" android:layout_height="52dp"
                android:background="@drawable/tile_bg">
                <ImageView android:layout_width="26dp" android:layout_height="26dp"
                    android:layout_gravity="center" android:src="@drawable/ic_gear" />
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:textColor="#FFFFFF" android:textSize="12sp"
                android:text="Settings" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
