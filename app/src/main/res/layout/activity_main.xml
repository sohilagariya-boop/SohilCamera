<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">
    <androidx.camera.view.PreviewView android:id="@+id/preview"
        android:layout_width="match_parent" android:layout_height="match_parent" />
    <TextView android:id="@+id/locText"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:layout_marginBottom="120dp"
        android:background="#88000000" android:textColor="#FFFFFF"
        android:padding="10dp" android:textSize="14sp" android:text="Location dhoondh raha hai..." />
    <Button android:id="@+id/captureBtn"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="40dp"
        android:text="Photo Lo" />
</FrameLayout>
