<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView android:id="@+id/preview"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <com.sohil.camera.GridOverlay android:id="@+id/grid"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:visibility="gone" />

    <View android:id="@+id/focusRing"
        android:layout_width="72dp" android:layout_height="72dp"
        android:background="@drawable/focus_ring" android:visibility="invisible" />

    <TextView android:id="@+id/countdown"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:textColor="#FFFFFF"
        android:textSize="110sp" android:textStyle="bold"
        android:shadowColor="#000000" android:shadowRadius="12"
        android:visibility="invisible" />

    <TextView android:id="@+id/zoomText"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom" android:layout_marginBottom="230dp"
        android:background="@drawable/chip_bg" android:textColor="#FFFFFF"
        android:paddingStart="14dp" android:paddingEnd="14dp"
        android:paddingTop="5dp" android:paddingBottom="5dp"
        android:textSize="14sp" android:visibility="invisible" />

    <!-- top: record timer + option chips -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top" android:orientation="vertical" android:paddingTop="34dp">

        <TextView android:id="@+id/recTimer"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:layout_marginBottom="6dp"
            android:background="#CCE53935" android:textColor="#FFFFFF"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingTop="4dp" android:paddingBottom="4dp"
            android:textSize="16sp" android:text="00:00" android:visibility="gone" />

        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none" android:paddingStart="12dp" android:paddingEnd="12dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/flashChip" style="@style/ChipText" android:text="⚡ Off" />
                <TextView android:id="@+id/timerChip" style="@style/ChipText" android:text="⏱ Off" />
                <TextView android:id="@+id/burstChip" style="@style/ChipText" android:text="🔁 1x" />
                <TextView android:id="@+id/gridChip" style="@style/ChipText" android:text="▦ Grid" />
                <TextView android:id="@+id/proChip" style="@style/ChipText" android:text="🎚 Pro" />
                <TextView android:id="@+id/setChip" style="@style/ChipText" android:text="⚙ Settings" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Pro panel -->
    <LinearLayout android:id="@+id/proPanel"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top" android:layout_marginTop="110dp"
        android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
        android:background="#BB000000" android:orientation="vertical"
        android:padding="12dp" android:visibility="gone">
        <TextView android:id="@+id/evLabel" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#FFFFFF"
            android:textSize="13sp" android:text="Exposure: 0.0" />
        <SeekBar android:id="@+id/evSeek" android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textColor="#FFFFFF" android:textSize="13sp"
            android:text="ISO (manual mode, shutter 1/60)" />
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none" android:layout_marginTop="4dp">
            <LinearLayout android:id="@+id/isoRow" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:orientation="horizontal" />
        </HorizontalScrollView>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textColor="#FFFFFF" android:textSize="13sp"
            android:text="White balance" />
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none" android:layout_marginTop="4dp">
            <LinearLayout android:id="@+id/wbRow" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <TextView android:id="@+id/locText"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:layout_marginBottom="185dp"
        android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
        android:background="#88000000" android:textColor="#FFFFFF"
        android:padding="10dp" android:textSize="13sp"
        android:text="Location dhoondh raha hai..." />

    <LinearLayout android:layout_width="wrap_content" android:layout_height="40dp"
        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="136dp"
        android:orientation="horizontal" android:gravity="center">
        <TextView android:id="@+id/photoTab"
            android:layout_width="wrap_content" android:layout_height="match_parent"
            android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp"
            android:text="PHOTO" android:textStyle="bold" android:textSize="14sp"
            android:textColor="#FFC107" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/videoTab"
            android:layout_width="wrap_content" android:layout_height="match_parent"
            android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp"
            android:text="VIDEO" android:textStyle="bold" android:textSize="14sp"
            android:textColor="#FFFFFF" android:clickable="true" android:focusable="true" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="130dp"
        android:layout_gravity="bottom" android:background="#66000000">

        <ImageView android:id="@+id/thumb"
            android:layout_width="64dp" android:layout_height="64dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="32dp"
            android:background="@drawable/thumb_bg"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:scaleType="centerCrop"
            android:contentDescription="Last photo" />

        <View android:id="@+id/captureBtn"
            android:layout_width="78dp" android:layout_height="78dp"
            android:layout_gravity="center"
            android:background="@drawable/capture_button"
            android:clickable="true" android:focusable="true" />

        <TextView android:id="@+id/flipBtn"
            android:layout_width="56dp" android:layout_height="56dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="36dp"
            android:background="@drawable/round_btn"
            android:gravity="center" android:text="🔄" android:textSize="24sp"
            android:clickable="true" android:focusable="true" />
    </FrameLayout>
</FrameLayout>
