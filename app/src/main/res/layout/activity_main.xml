<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#000000">

    <!-- top icon bar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="#000000"
        android:paddingTop="30dp" android:paddingBottom="6dp">

        <LinearLayout android:id="@+id/btnMenu" style="@style/TopBtn">
            <ImageView style="@style/TopIcon" android:src="@drawable/ic_menu" />
            <TextView style="@style/TopLabel" android:text="Menu" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btnTimer" style="@style/TopBtn">
            <ImageView android:id="@+id/iconTimer" style="@style/TopIcon" android:src="@drawable/ic_timer" />
            <TextView android:id="@+id/lblTimer" style="@style/TopLabel" android:text="Off" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btnBurst" style="@style/TopBtn">
            <ImageView android:id="@+id/iconBurst" style="@style/TopIcon" android:src="@drawable/ic_burst" />
            <TextView android:id="@+id/lblBurst" style="@style/TopLabel" android:text="1x" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btnGrid" style="@style/TopBtn">
            <ImageView android:id="@+id/iconGrid" style="@style/TopIcon" android:src="@drawable/ic_grid" />
            <TextView android:id="@+id/lblGrid" style="@style/TopLabel" android:text="Off" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btnFlash" style="@style/TopBtn">
            <ImageView android:id="@+id/iconFlash" style="@style/TopIcon" android:src="@drawable/ic_flash_off" />
            <TextView android:id="@+id/lblFlash" style="@style/TopLabel" android:text="Off" />
        </LinearLayout>
    </LinearLayout>

    <!-- preview area -->
    <FrameLayout android:id="@+id/previewBox"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

        <androidx.camera.view.PreviewView android:id="@+id/preview"
            android:layout_width="match_parent" android:layout_height="match_parent" />

        <com.sohil.camera.GridOverlay android:id="@+id/grid"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone" />

        <View android:id="@+id/focusRing"
            android:layout_width="72dp" android:layout_height="72dp"
            android:background="@drawable/focus_ring" android:visibility="invisible" />

        <TextView android:id="@+id/countdown"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:textColor="#FFFFFF"
            android:textSize="110sp" android:textStyle="bold"
            android:shadowColor="#000000" android:shadowRadius="12"
            android:visibility="invisible" />

        <TextView android:id="@+id/zoomText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:background="@drawable/chip_bg"
            android:textColor="#FFFFFF" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="6dp" android:paddingBottom="6dp"
            android:textSize="18sp" android:visibility="invisible" />

        <TextView android:id="@+id/locText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|start" android:layout_margin="8dp"
            android:maxWidth="260dp" android:maxLines="4"
            android:background="#66000000" android:textColor="#FFFFFF"
            android:padding="6dp" android:textSize="11sp"
            android:text="Location dhoondh raha hai..." />

        <TextView android:id="@+id/recTimer"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|end" android:layout_margin="8dp"
            android:background="#CCE53935" android:textColor="#FFFFFF"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingTop="4dp" android:paddingBottom="4dp"
            android:textSize="15sp" android:text="00:00" android:visibility="gone" />

        <!-- pro panel -->
        <LinearLayout android:id="@+id/proPanel"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="bottom" android:layout_marginBottom="54dp"
            android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
            android:background="#CC000000" android:orientation="vertical"
            android:padding="8dp" android:visibility="gone">

            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="52dp">
                <HorizontalScrollView android:id="@+id/wbScroll"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <LinearLayout android:id="@+id/wbRow" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:orientation="horizontal" />
                </HorizontalScrollView>
                <HorizontalScrollView android:id="@+id/isoScroll"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:scrollbars="none" android:visibility="gone">
                    <LinearLayout android:id="@+id/isoRow" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:orientation="horizontal" />
                </HorizontalScrollView>
                <LinearLayout android:id="@+id/evBox" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:visibility="gone">
                    <TextView android:id="@+id/evLabel" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="#FFFFFF"
                        android:textSize="12sp" android:text="Exposure: 0.0" />
                    <SeekBar android:id="@+id/evSeek" android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="6dp">
                <TextView android:id="@+id/tabWb" style="@style/ProTab" android:text="WB · Auto" />
                <TextView android:id="@+id/tabIso" style="@style/ProTab" android:text="ISO · Auto" />
                <TextView android:id="@+id/tabEv" style="@style/ProTab" android:text="EV · 0.0" />
            </LinearLayout>
        </LinearLayout>

        <!-- zoom quick buttons -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="10dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/z1" style="@style/ZoomChip" android:text="1x" />
            <TextView android:id="@+id/z2" style="@style/ZoomChip" android:text="2x" />
            <TextView android:id="@+id/z4" style="@style/ZoomChip" android:text="4x" />
        </LinearLayout>
    </FrameLayout>

    <!-- bottom -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="#000000">

        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
            android:orientation="horizontal" android:gravity="center">
            <TextView android:id="@+id/photoTab" style="@style/ModeTab" android:text="PHOTO" />
            <TextView android:id="@+id/videoTab" style="@style/ModeTab" android:text="VIDEO" />
            <TextView android:id="@+id/proTabMode" style="@style/ModeTab" android:text="PRO" />
        </LinearLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="110dp">
            <ImageView android:id="@+id/thumb"
                android:layout_width="62dp" android:layout_height="62dp"
                android:layout_gravity="center_vertical|start" android:layout_marginStart="32dp"
                android:background="@drawable/thumb_bg" android:clipToOutline="true"
                android:outlineProvider="background" android:scaleType="centerCrop"
                android:contentDescription="Last photo" />
            <View android:id="@+id/captureBtn"
                android:layout_width="78dp" android:layout_height="78dp"
                android:layout_gravity="center" android:background="@drawable/capture_button"
                android:clickable="true" android:focusable="true" />
            <ImageView android:id="@+id/flipBtn"
                android:layout_width="56dp" android:layout_height="56dp"
                android:layout_gravity="center_vertical|end" android:layout_marginEnd="36dp"
                android:background="@drawable/round_btn" android:padding="15dp"
                android:src="@drawable/ic_flip" android:clickable="true" android:focusable="true"
                android:contentDescription="Switch camera" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
